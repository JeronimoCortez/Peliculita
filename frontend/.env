# Peliculita — frontend (POC)
# Este entregable no tiene backend propio (ver README.md): el motor de
# scoring, el agente de chat y la persistencia de producto corren en el
# cliente contra localStorage. La auth sí es real: Google OAuth vía Supabase
# Auth (lib/auth.ts, lib/supabaseClient.ts).
#
# Los valores reales de proyecto van en frontend/.env.local (gitignored, no
# se versiona). Este .env solo deja declaradas las claves como base.

NEXT_PUBLIC_APP_NAME=Peliculita
NEXT_PUBLIC_APP_ENV=development

# Requeridas para el login con Google (ver README.md > Auth con Google):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cuando exista backend propio además de Supabase, agregar acá:
# NEXT_PUBLIC_API_BASE_URL=
